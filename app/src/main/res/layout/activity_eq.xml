<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/eqToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1E1E1E"
            app:title="SjbZ Equalizer 32 Bandas + MDRC + ATS2835P"
            app:titleTextColor="#FFFF7700" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchEqEnabled" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="EQ" android:textColor="#FFF"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchMdrcEnabled" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="MDRC" android:textColor="#FFF"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchGlobalSystemEq" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Global System EQ" android:textColor="#FFFF7700"/>
            <Button android:id="@+id/btnGlobalHelp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="?"/>
        </LinearLayout>
        <TextView android:id="@+id/tvActiveSessionsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modo local" android:textColor="#AAA"/>
        <Spinner android:id="@+id/spinnerPresets" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnSavePreset" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Guardar"/>
            <Button android:id="@+id/btnDeletePreset" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Borrar"/>
            <Button android:id="@+id/btnExportSjbz" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Export"/>
            <Button android:id="@+id/btnImportSjbz" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Import"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Preamp" android:textColor="#FFF" android:layout_marginTop="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <SeekBar android:id="@+id/seekBarPreamp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="240" android:progress="120"/>
            <TextView android:id="@+id/tvPreampValue" android:layout_width="70dp" android:layout_height="wrap_content" android:text="+0.0 dB" android:textColor="#FFFF7700"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speed" android:textColor="#FFF"/>
            <SeekBar android:id="@+id/seekBarSpeed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="150" android:progress="50"/>
            <TextView android:id="@+id/tvSpeedValue" android:layout_width="70dp" android:layout_height="wrap_content" android:text="1.00x" android:textColor="#FFF"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Crossfade" android:textColor="#FFF"/>
            <SeekBar android:id="@+id/seekBarCrossfade" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="12"/>
            <TextView android:id="@+id/tvCrossfadeValue" android:layout_width="70dp" android:layout_height="wrap_content" android:text="0s" android:textColor="#FFF"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SjbZ Equalizer 32 Bandas + MDRC + ATS2835P" android:textColor="#FFFF7700" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="16dp"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvEqBands" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="280dp" android:background="#1E1E1E" android:visibility="gone">
            <LinearLayout android:id="@+id/container32Bands" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal"/>
        </HorizontalScrollView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="12dp" app:cardBackgroundColor="#FF1E1E1E">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BASSBOOST PSICOACÚSTICO +15dB" android:textColor="#FFFF7700" android:textStyle="bold" android:textSize="12sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:weightSum="3">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnFreq60" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="60Hz&#10;SUB" android:textSize="10sp" app:cornerRadius="8dp"/>
                    <!-- CORREGIDO: solo 1 layout_weight -->
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnFreq85" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:text="85Hz&#10;PUNCH" android:textSize="10sp" app:cornerRadius="8dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnFreq120" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="120Hz&#10;MID-BASS" android:textSize="10sp" app:cornerRadius="8dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/btnBassOff" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="OFF" android:textSize="9sp"/>
                    <Button android:id="@+id/btnBass3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="+3" android:textSize="9sp"/>
                    <Button android:id="@+id/btnBass6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="+6" android:textSize="9sp"/>
                    <Button android:id="@+id/btnBass9" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="+9" android:textSize="9sp"/>
                    <Button android:id="@+id/btnBass12" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="+12" android:textSize="9sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GAIN:" android:textColor="#FFAAAAAA" android:textSize="11sp"/>
                    <SeekBar android:id="@+id/seekBassGain" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:max="150"/>
                    <SeekBar android:id="@+id/seekBassBoost" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="1000" android:progress="400" android:visibility="gone"/>
                    <TextView android:id="@+id/tvBassGainSide" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="+6.0dB" android:textColor="#FFFF7700" android:textStyle="bold" android:textSize="12sp" android:minWidth="45dp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvBassBoostValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+6.0 dB (40%) ACTIVO" android:textColor="#FFFF7700" android:gravity="center" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardMdrc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="12dp" app:cardBackgroundColor="#FF1E1E1E">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MDRC 5-Bandas ATS2835P" android:textColor="#FF00BCD4" android:textStyle="bold" android:textSize="12sp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMdrcBands" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Sub" android:textColor="#FFF"/><SeekBar android:id="@+id/sbMdrcGainSub" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="240" android:progress="120"/><TextView android:id="@+id/tvMdrcGainSub" android:layout_width="70dp" android:layout_height="wrap_content" android:text="+0.0 dB" android:textColor="#FFF"/></LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Low" android:textColor="#FFF"/><SeekBar android:id="@+id/sbMdrcGainLow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="240" android:progress="120"/><TextView android:id="@+id/tvMdrcGainLow" android:layout_width="70dp" android:layout_height="wrap_content" android:text="+0.0 dB" android:textColor="#FFF"/></LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Mid" android:textColor="#FFF"/><SeekBar android:id="@+id/sbMdrcGainMid" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="240" android:progress="120"/><TextView android:id="@+id/tvMdrcGainMid" android:layout_width="70dp" android:layout_height="wrap_content" android:text="+0.0 dB" android:textColor="#FFF"/></LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="High" android:textColor="#FFF"/><SeekBar android:id="@+id/sbMdrcGainHigh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="240" android:progress="120"/><TextView android:id="@+id/tvMdrcGainHigh" android:layout_width="70dp" android:layout_height="wrap_content" android:text="+0.0 dB" android:textColor="#FFF"/></LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Air" android:textColor="#FFF"/><SeekBar android:id="@+id/sbMdrcGainAir" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="240" android:progress="120"/><TextView android:id="@+id/tvMdrcGainAir" android:layout_width="70dp" android:layout_height="wrap_content" android:text="+0.0 dB" android:textColor="#FFF"/></LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
