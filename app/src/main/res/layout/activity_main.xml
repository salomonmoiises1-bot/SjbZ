<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aimp_black">

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Toolbar -->
        <include
            android:id="@+id/includedToolbar"
            layout="@layout/toolbar" />

        <!-- Status & DSP Active Banner -->
        <LinearLayout
            android:id="@+id/bannerDspStatus"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="#161616"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/aimp_orange" />

            <TextView
                android:id="@+id/tvDspActiveStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="ATS2835P DSP • 32-Band PreEq • 5-Band MDRC • Limiter Active"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPlaylistTrackCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 tracks"
                android:textColor="@color/aimp_orange"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Central Playlist RecyclerView (Drag & drop, Swipe to delete) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlaylist"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

            <!-- Empty State View -->
            <LinearLayout
                android:id="@+id/emptyView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_music_note"
                    app:tint="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No se encontraron pistas de audio"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnScanStorage"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/aimp_orange"
                    android:text="Escanear Memoria"
                    android:textColor="@color/aimp_black"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom AIMP Player Panel -->
        <LinearLayout
            android:id="@+id/bottomPlayerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/aimp_black_surface"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <!-- Stereo VU Meters & Waveform Bar (AIMP style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginBottom="6dp"
                android:background="#0F0F0F"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="L"
                    android:textColor="@color/aimp_orange"
                    android:textSize="9sp" />

                <!-- Left VU Meter Progress -->
                <ProgressBar
                    android:id="@+id/vuMeterLeftBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="45"
                    android:progressTint="@color/vu_green" />

                <!-- Center Waveform Peak Indicator -->
                <TextView
                    android:id="@+id/tvVuPeakText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="-3.2 dB"
                    android:textColor="@color/aimp_orange"
                    android:textSize="9sp" />

                <!-- Right VU Meter Progress -->
                <ProgressBar
                    android:id="@+id/vuMeterRightBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="52"
                    android:progressTint="@color/vu_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="R"
                    android:textColor="@color/aimp_orange"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Track Info Row: Large Artwork + Title / Artist / Tech specs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPlayerArtwork"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_aimp_card"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music_note"
                    app:tint="@color/aimp_orange" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlayerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:fontFamily="sans-serif-bold"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:text="Selecciona una pista"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvPlayerArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="SjbZ Hi-Res Player"
                        android:textColor="@color/aimp_orange"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPlayerTechSpecs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="24-bit • 192kHz • ATS2835P"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Seekbar with Elapsed and Remaining Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvElapsedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-mono"
                    android:text="0:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/playerSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="@color/aimp_orange"
                    android:thumbTint="@color/aimp_orange" />

                <TextView
                    android:id="@+id/tvRemainingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-mono"
                    android:text="-0:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- AIMP Control Buttons Row: Shuffle, Prev, Stop, Play/Pause, Next, Repeat, Crossfade -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Shuffle Button -->
                <ImageButton
                    android:id="@+id/btnShuffle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Shuffle"
                    android:src="@drawable/ic_shuffle"
                    app:tint="@color/text_muted" />

                <!-- Prev Button -->
                <ImageButton
                    android:id="@+id/btnPrevious"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Previous"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/text_primary" />

                <!-- Stop Button -->
                <ImageButton
                    android:id="@+id/btnStop"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Stop"
                    android:src="@drawable/ic_stop"
                    app:tint="@color/text_secondary" />

                <!-- Play / Pause Button (Large Orange AIMP circle) -->
                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/bg_play_btn"
                    android:contentDescription="Play/Pause"
                    android:src="@drawable/ic_play"
                    app:tint="@color/aimp_black" />

                <!-- Next Button -->
                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Next"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/text_primary" />

                <!-- Repeat / Loop Mode Button -->
                <ImageButton
                    android:id="@+id/btnRepeat"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Repeat Loop"
                    android:src="@drawable/ic_repeat"
                    app:tint="@color/aimp_orange" />

                <!-- Crossfade Button -->
                <ImageButton
                    android:id="@+id/btnCrossfade"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Crossfade"
                    android:src="@drawable/ic_crossfade"
                    app:tint="@color/aimp_orange" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Navigation Drawer (Playlists, Favoritos, Historial, Carpetas) -->
    <LinearLayout
        android:id="@+id/navDrawerView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/aimp_black_surface"
        android:orientation="vertical"
        android:paddingTop="32dp">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="SjbZ"
                android:textColor="@color/aimp_orange"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motor AIMP &amp; ATS2835P DSP"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/aimp_border" />

        <!-- Drawer Menu Items -->
        <TextView
            android:id="@+id/drawerItemPlaylists"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="@string/drawer_playlists"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/drawerItemFavorites"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="@string/drawer_favorites"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/drawerItemHistory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="@string/drawer_history"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/drawerItemFolders"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="@string/drawer_folders"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/aimp_border" />

        <TextView
            android:id="@+id/drawerExportM3U8"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="Exportar M3U8"
            android:textColor="@color/aimp_orange"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/drawerImportM3U8"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="Importar M3U8"
            android:textColor="@color/aimp_orange"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
