<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/studio_black"
    android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar android:id="@+id/eqToolbar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/studio_surface" android:elevation="4dp" app:navigationIcon="?attr/homeAsUpIndicator">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-bold" android:text="SB-Z Studio DSP PRO" android:textColor="@color/studio_cyan" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ecualizador 32 Bandas ISO • 32-bit Float" android:textColor="@color/text_muted" android:textSize="10sp" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchMasterDsp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" app:thumbTint="@color/studio_cyan" app:trackTint="@color/studio_cyan_alpha" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <ScrollView android:id="@+id/scrollRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_studio_card" android:clipToPadding="true" android:padding="4dp">
                <com.sjbz.aimp.ui.AudioSpectrumVisualizerView android:id="@+id/visualizerView" android:layout_width="match_parent" android:layout_height="match_parent" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="6dp" android:background="#660A0E17" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="60 FPS • 2048 FFT" android:textColor="@color/studio_cyan" android:textSize="9sp" android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout android:id="@+id/layoutGenreCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_studio_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Reconocimiento de Género" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/tvRecognizedGenre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/studio_charcoal" android:fontFamily="sans-serif-bold" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:text="Rock" android:textColor="@color/studio_cyan" android:textSize="12sp" />
                        <TextView android:id="@+id/tvGenreTrackInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1" android:text="Detectado automáticamente" android:textColor="@color/text_muted" android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
                <Button android:id="@+id/btnAutoEqGenre" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="36dp" android:backgroundTint="@color/studio_cyan_alpha" android:paddingHorizontal="12dp" android:text="Adaptar EQ" android:textColor="@color/studio_cyan" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_studio_card" android:orientation="vertical" android:padding="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-bold" android:text="Presets Rápidos" android:textColor="@color/text_secondary" android:textSize="11sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnPresetFlat" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="38dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:paddingHorizontal="4dp" android:text="Flat" android:textColor="@color/text_primary" android:textSize="11sp" />
                    <Button android:id="@+id/btnPresetBass" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="38dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:paddingHorizontal="4dp" android:text="Bass" android:textColor="@color/text_primary" android:textSize="11sp" />
                    <Button android:id="@+id/btnPresetRock" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="38dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:paddingHorizontal="4dp" android:text="Rock" android:textColor="@color/text_primary" android:textSize="11sp" />
                    <Button android:id="@+id/btnPresetVocal" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:paddingHorizontal="4dp" android:text="Vocal" android:textColor="@color/text_primary" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <Spinner android:id="@+id/spinnerPresets" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_studio_card" android:popupBackground="@color/studio_surface" />
                    <ImageButton android:id="@+id/btnSavePreset" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Guardar Preset" android:src="@drawable/ic_heart_filled" app:tint="@color/studio_cyan" />
                    <ImageButton android:id="@+id/btnExportPreset" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Exportar Preset" android:src="@drawable/ic_search" app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_studio_card" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-bold" android:text="Preamplificador (-12 a +12 dB)" android:textColor="@color/text_primary" android:textSize="12sp" />
                    <TextView android:id="@+id/tvPreampValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-bold" android:text="0.0 dB" android:textColor="@color/studio_cyan" android:textSize="12sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekBarPreamp" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="2dp" android:max="240" android:progress="120" android:progressTint="@color/studio_cyan" android:thumbTint="@color/studio_cyan" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="@color/studio_border" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-bold" android:text="Realce de Graves (Low-Shelf RBJ)" android:textColor="@color/text_primary" android:textSize="12sp" />
                    <TextView android:id="@+id/tvBassBoostValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:fontFamily="sans-serif-bold" android:text="+4.0 dB" android:textColor="@color/studio_cyan" android:textSize="12sp" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchBassBoost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" app:thumbTint="@color/studio_cyan" app:trackTint="@color/studio_cyan_alpha" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="Frecuencia:" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <Spinner android:id="@+id/spinnerBassFreq" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:background="@drawable/bg_studio_card" android:popupBackground="@color/studio_surface" />
                </LinearLayout>
                <SeekBar android:id="@+id/seekBarBassBoost" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="4dp" android:max="120" android:progress="40" android:progressTint="@color/studio_cyan" android:thumbTint="@color/studio_cyan" />
            </LinearLayout>

            <!-- CORREGIDO: Pre-amp Tono agregado aquí -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_studio_card" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-bold" android:text="Pre-amp Tono (Bass / Mid / Treble)" android:textColor="@color/studio_cyan" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Bass" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                    <SeekBar android:id="@+id/seekBarToneBass" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:max="240" android:progress="120" android:progressTint="@color/studio_cyan" android:thumbTint="@color/studio_cyan"/>
                    <TextView android:id="@+id/tvToneBassValue" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end" android:text="0.0 dB" android:textColor="@color/studio_cyan" android:textSize="11sp" android:fontFamily="sans-serif-bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Mid" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                    <SeekBar android:id="@+id/seekBarToneMid" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:max="240" android:progress="120" android:progressTint="@color/studio_cyan" android:thumbTint="@color/studio_cyan"/>
                    <TextView android:id="@+id/tvToneMidValue" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end" android:text="0.0 dB" android:textColor="@color/studio_cyan" android:textSize="11sp" android:fontFamily="sans-serif-bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Treble" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                    <SeekBar android:id="@+id/seekBarToneTreble" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:max="240" android:progress="120" android:progressTint="@color/studio_cyan" android:thumbTint="@color/studio_cyan"/>
                    <TextView android:id="@+id/tvToneTrebleValue" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end" android:text="0.0 dB" android:textColor="@color/studio_cyan" android:textSize="11sp" android:fontFamily="sans-serif-bold"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
